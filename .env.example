# Frontend (publishable values only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Required for GitHub Pages: browser calls this HTTPS FastAPI origin directly.
# Leave empty for the local Next.js proxy; set the live HTTPS origin for Pages.
NEXT_PUBLIC_API_ORIGIN=
# GitHub Actions sets this from configure-pages. Empty for localhost/custom domains.
NEXT_PUBLIC_BASE_PATH=
# Required for Netlify builds: separately hosted FastAPI HTTPS origin, no trailing slash.
EVALIO_API_ORIGIN=https://api.example.com

# FastAPI server (never set these as NEXT_PUBLIC_* variables)
APP_ENV=development
DATABASE_URL=postgresql+psycopg://user:password@host:6543/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
IP_HASH_SALT=replace-with-long-random-secret
ALLOWED_HOSTS=api.example.com
ALLOWED_ORIGINS=https://example.netlify.app
GROQ_API_KEY=your-server-side-key
# Gemini is the default. Groq and Routeway remain optional alternatives.
ESSAY_AI_PROVIDER=gemini
GEMINI_API_KEY=your-google-gemini-server-side-key
ESSAY_AI_MODEL=gemini-3.5-flash-lite
ROUTEWAY_API_KEY=your-routeway-server-side-key
# Optional; each provider has its own default model.
# ESSAY_AI_MODEL=gemma-4-26b-a4b-it-chimerax:free
